# Local Supabase defaults (after `supabase start`).
# Phase 0F populates the real .env.local from `supabase status` output.

# Direct Postgres connection (used by Drizzle + pipeline psycopg).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase JS client (browser + server).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key — never expose to the browser. Used by API routes for
# privileged operations (storage uploads, anonymous user upserts, etc.).
SUPABASE_SERVICE_ROLE_KEY=
