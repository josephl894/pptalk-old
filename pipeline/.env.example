# Required for v0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (local dev defaults; `supabase start` will print real values)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional — override the default LibreOffice binary path (macOS default is used if unset)
LIBREOFFICE_PATH=

# Optional — for v0.5 TTS bake-off
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
